<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.bong.springboard.member.dao.MemberDAO">
	<select id="selectMemberByLoginId"
	        parameterType="String"
	        resultType="com.bong.springboard.member.dto.MemberDTO">
	
	    SELECT
	        member_id,
	        login_id,
	        password,
	        name,
	        role,
	        delete_yn,
	        created_at,
	        updated_at
	    FROM member
	    WHERE login_id = #{loginId}
	      AND delete_yn = 'N'
	
	</select>
	
</mapper>